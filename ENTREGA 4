USE Ventas_Tech_DB;

------PRIMERA CONSULTA - RESUMEN EJECUTIVO MENSUAL-----
SELECT 
    MONTH(fecha_venta) AS mes,
    SUM(cantidad * precio_unitario) AS total_facturado,
    COUNT(id_venta) AS cantidad_pedidos,
    AVG(cantidad * precio_unitario) AS ticket_promedio
FROM ventas
GROUP BY MONTH(fecha_venta)
ORDER BY mes;

-------SEGUNDA CONSULTA ---- RANKING DE PRODUCTOS TOP 5----------
SELECT TOP 5
    id_producto,
    SUM(cantidad) AS unidades_vendidas,
    SUM(cantidad * precio_unitario) AS total_facturado
FROM ventas
GROUP BY id_producto
ORDER BY total_facturado DESC;

-------------TERCERA CONSULTA---CLIENTES RECURRENTES-----
SELECT 
    id_cliente,
    COUNT(id_venta) AS cantidad_pedidos,
    SUM(cantidad * precio_unitario) AS total_gastado
FROM ventas
GROUP BY id_cliente
HAVING COUNT(id_venta) > 1
ORDER BY cantidad_pedidos DESC;

----CUARTA CONSULTA----COMPARACION MENSUAL TOTAL CONTRA EL PROMEDIO GENERAL------
WITH FacturacionMensual AS (
    SELECT 
        MONTH(fecha_venta) AS mes,
        SUM(cantidad * precio_unitario) AS total_facturado
    FROM ventas
    GROUP BY MONTH(fecha_venta)
),
PromedioGeneral AS (
    SELECT AVG(total_facturado) AS promedio_mensual
    FROM FacturacionMensual
)
SELECT 
    fm.mes,
    fm.total_facturado,
    CASE 
        WHEN fm.total_facturado >= pg.promedio_mensual THEN 'Por encima'
        ELSE 'Por debajo'
    END AS rendimiento_vs_promedio
FROM FacturacionMensual fm
CROSS JOIN PromedioGeneral pg
ORDER BY fm.mes;

